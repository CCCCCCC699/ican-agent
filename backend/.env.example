# 申城智行 环境配置示例
# 复制本文件为 .env 并填入你的真实值（.env 已被 gitignore，不会上传）

# ---- 云API（三选一填，都是OpenAI兼容协议）----
# 硅基流动（免费额度，推荐）: https://cloud.siliconflow.cn 注册后在"API密钥"创建
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-你的密钥
LLM_API_MODEL=Qwen/Qwen3-8B

# DeepSeek: https://platform.deepseek.com （按量计费，¥10起充）
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的密钥
# LLM_API_MODEL=deepseek-chat

# 智谱: https://open.bigmodel.cn （GLM-4-Flash 免费）
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的密钥
# LLM_API_MODEL=glm-4-flash

# ---- Neo4j（默认值，无需修改）----
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=ican2026
